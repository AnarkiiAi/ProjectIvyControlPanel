<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/anarkiiRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101014">

    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="400dp"
        android:layout_height="300dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="40dp"
        android:background="@drawable/control_panel_glass"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/anarkiiLogo"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="ANARKII Logo"
                android:scaleType="fitCenter"
                android:src="@drawable/anarkii_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="ANARKII CONTROL"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:maxLines="1"
                    android:text="Control Center"
                    android:textColor="#BFFFFFFF"
                    android:textSize="9sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="75dp"
                android:layout_height="match_parent"
                android:gravity="center_vertical|end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/timeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:maxLines="1"
                    android:text="10:42 PM"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/dateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:maxLines="1"
                    android:text="Sat, 30 Aug"
                    android:textColor="#BFFFFFFF"
                    android:textSize="7sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/searchButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/control_panel_glass"
                android:gravity="center"
                android:text="⌕"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/settingsButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/control_panel_glass"
                android:gravity="center"
                android:text="⚙"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- TOP ROW -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="94dp"
            android:layout_marginTop="7dp"
            android:orientation="horizontal">

            <!-- Ethernet -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/control_tile_glass">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="2dp"
                    android:src="@drawable/ic_ethernet" />

                <TextView
                    android:id="@+id/ethernetTile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="bottom|center_horizontal"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:paddingBottom="8dp"
                    android:text="Ethernet&#10;Connected"
                    android:textAlignment="center"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp" />

            </FrameLayout>

            <!-- Bluetooth -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/control_tile_glass">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="2dp"
                    android:src="@drawable/ic_bluetooth" />

                <TextView
                    android:id="@+id/bluetoothTile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="bottom|center_horizontal"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:paddingBottom="8dp"
                    android:text="Bluetooth&#10;On"
                    android:textAlignment="center"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp" />

            </FrameLayout>

            <!-- Device -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/control_tile_glass">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="2dp"
                    android:src="@drawable/ic_device" />

                <TextView
                    android:id="@+id/deviceTile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="bottom|center_horizontal"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:paddingBottom="8dp"
                    android:text="Device&#10;SHIELD TV"
                    android:textAlignment="center"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp" />

            </FrameLayout>

            <!-- Volume -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/control_tile_glass">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="2dp"
                    android:src="@drawable/ic_volume" />

                <TextView
                    android:id="@+id/volumeTile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="bottom|center_horizontal"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:paddingBottom="8dp"
                    android:text="Volume&#10;35%"
                    android:textAlignment="center"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp" />

            </FrameLayout>

            <!-- Display -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:background="@drawable/control_tile_glass">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="2dp"
                    android:src="@drawable/ic_display" />

                <TextView
                    android:id="@+id/displayTile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="bottom|center_horizontal"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:paddingBottom="8dp"
                    android:text="Display&#10;2160p 60 HDR"
                    android:textAlignment="center"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp" />

            </FrameLayout>

        </LinearLayout>

        <!-- BOTTOM ROW -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="94dp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <!-- Projectivy -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/control_tile_glass">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="2dp"
                    android:src="@drawable/ic_projectivy" />

                <TextView
                    android:id="@+id/projectivyTile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="bottom|center_horizontal"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:paddingBottom="8dp"
                    android:text="Projectivy&#10;Settings"
                    android:textAlignment="center"
                    android:textColor="#FFFFFF"
                    android:textSize="8sp" />

            </FrameLayout>

            <!-- Apps -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/control_tile_glass">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="2dp"
                    android:src="@drawable/ic_apps" />

                <TextView
                    android:id="@+id/appsTile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="bottom|center_horizontal"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:paddingBottom="8dp"
                    android:text="Apps&#10;Manage"
                    android:textAlignment="center"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp" />

            </FrameLayout>

            <!-- Storage -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/control_tile_glass">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="2dp"
                    android:src="@drawable/ic_storage" />

                <TextView
                    android:id="@+id/storageTile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="bottom|center_horizontal"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:paddingBottom="8dp"
                    android:text="Storage&#10;42% Used"
                    android:textAlignment="center"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp" />

            </FrameLayout>

            <!-- Clear Memory -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/control_tile_glass">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="2dp"
                    android:src="@drawable/ic_memory" />

                <TextView
                    android:id="@+id/memoryTile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="bottom|center_horizontal"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:paddingBottom="8dp"
                    android:text="Clear&#10;Memory"
                    android:textAlignment="center"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp" />

            </FrameLayout>

            <!-- System Update -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:background="@drawable/control_tile_glass">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="2dp"
                    android:src="@drawable/ic_update" />

                <TextView
                    android:id="@+id/updateTile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="bottom|center_horizontal"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:paddingBottom="8dp"
                    android:text="System&#10;Update"
                    android:textAlignment="center"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp" />

            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>